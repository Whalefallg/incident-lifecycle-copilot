# ============================================================
# Local demo defaults
# ============================================================

RAG_MODE=local
REDIS_STATE_ENABLED=false
SEMANTIC_CACHE_ENABLED=false
MODEL_ROUTING_ENABLED=false


# ============================================================
# Chat model — required for Agent execution
# ============================================================

# azure | openai | qwen | deepseek | zhipu | openai-compatible
MODEL_PROVIDER=openai-compatible

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=


# ============================================================
# Azure OpenAI — required only when MODEL_PROVIDER=azure
# ============================================================

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_VERSION=


# ============================================================
# Knowledge review
# ============================================================

# Local demo token used only for review / approve / reject mutations.
ADMIN_TOKEN=dev-admin


# ============================================================
# Redis — optional for the local demo
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0


# ============================================================
# rag-as-mcp — required only when RAG_MODE=mcp
# ============================================================

RAG_MCP_SERVER_PATH=
RAG_MCP_PYTHON=
# Optional command override, for example: ["python","main.py"]
# RAG_MCP_COMMAND=
RAG_MCP_SETTINGS_PATH=
RAG_MCP_COLLECTION=default
RAG_MCP_STARTUP_TIMEOUT_SECONDS=10
RAG_MCP_REQUEST_TIMEOUT_SECONDS=30
RAG_MCP_MAX_RETRIES=1
