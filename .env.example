# Retrieval mode: auto (startup fallback), mcp (required), or local (deterministic baseline)
RAG_MODE=auto
# Local checkout of https://github.com/Whalefallg/rag-as-mcp (required for mcp mode)
RAG_MCP_SERVER_PATH=
# Optional interpreter/command/settings overrides
RAG_MCP_PYTHON=
# RAG_MCP_COMMAND=["python","main.py"]
RAG_MCP_SETTINGS_PATH=
RAG_MCP_COLLECTION=default
RAG_MCP_STARTUP_TIMEOUT_SECONDS=10
RAG_MCP_REQUEST_TIMEOUT_SECONDS=30
RAG_MCP_MAX_RETRIES=1
